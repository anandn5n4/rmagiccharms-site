# Local server state
.pid
__pycache__/
*.py[cod]

# OS/editor files
.DS_Store
Thumbs.db
.vscode/

# Master media. media-src/ is the working area: the full-resolution originals
# stay on your machine, but the album metadata that describes them is tracked
# so the site can always be rebuilt from this repository.
media-src/**
!media-src/**/
!media-src/**/album.json
!media-src/**/captions.json
!media-src/site.json

# Video is never re-encoded, so only the published homepage loop is committed.
*.mp4
*.mpeg
*.webm
*.mov
*.m4v
!resources/video/hero-loop.mp4
